	measure 'Giá trị Account' =
			
			[Giá trị]
		lineageTag: e284aa37-cdea-4dab-b45a-d031ce5b7012

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Giá trị P&L_TY' =
			
			VAR _STT =
			    SELECTEDVALUE(DimPL[STT])
			
			VAR _STTChiTiet =
			    SELECTEDVALUE(DimPL[STT Chi tiết])
			
			VAR _ChiTiet =
			    SELECTEDVALUE(DimPL[Chi tiết])
			
			VAR _Nhom =
			    SELECTEDVALUE(DimPL[Nhóm])
			
			VAR _TaiKhoan =
			    COALESCE(
			        SELECTEDVALUE(DimSubAccount[Tài khoản]),
			        SELECTEDVALUE(DimPL[Tài khoản])
			    )
			
			VAR _TaiKhoans =
			    VALUES(DimSubAccount[Tài khoản])
			
			VAR _TaiKhoansTheoChiTiet =
			    FILTER(
			        _TaiKhoans,
			        VAR _TaiKhoanHienTai = DimSubAccount[Tài khoản]
			        RETURN
			            ISBLANK(_ChiTiet)
			                && ISBLANK(_Nhom)
			                || CALCULATE(
			                    COUNTROWS(DimPL),
			                    FILTER(
			                        ALL(DimPL),
			                        (ISBLANK(_ChiTiet) || DimPL[Chi tiết] = _ChiTiet)
			                            && (ISBLANK(_Nhom) || DimPL[Nhóm] = _Nhom)
			                            && NOT ISBLANK(DimPL[Tài khoản])
			                            && VALUE(DimPL[Tài khoản]) = _TaiKhoanHienTai
			                    )
			                ) > 0
			    )
			
			VAR _IsSubAccount =
			    HASONEVALUE(DimSubAccount[Diễn giải tiểu khoản])
			        && COUNTROWS(_TaiKhoans) > 0
			
			VAR _IsValidAccountForDetail =
			    NOT _IsSubAccount
			        || (
			            ISBLANK(_ChiTiet)
			                && ISBLANK(_Nhom)
			        )
			        || (
			            CALCULATE(
			                COUNTROWS(DimPL),
			                FILTER(
			                    ALL(DimPL),
			                    (ISBLANK(_ChiTiet) || DimPL[Chi tiết] = _ChiTiet)
			                        && (ISBLANK(_Nhom) || DimPL[Nhóm] = _Nhom)
			                        && NOT ISBLANK(DimPL[Tài khoản])
			                        && CONTAINS(
			                            _TaiKhoans,
			                            DimSubAccount[Tài khoản],
			                            VALUE(DimPL[Tài khoản])
			                        )
			                )
			            ) > 0
			        )
			
			VAR _IsBlankDetail =
			    ISINSCOPE(DimPL[Chi tiết])
			        && ISBLANK(
			            SELECTEDVALUE(DimPL[Chi tiết])
			        )
			
			VAR _MaxDate =
			    [MaxDate]
			
			VAR _StartDate =
			    DATE(
			        YEAR(_MaxDate),
			        1,
			        1
			    )
			
			VAR _GiaTriChiTiet =
			    -CALCULATE(
			        SUM(fact_finance[Trị giá]),
			        DATESBETWEEN(
			            Calendar[Date],
			            _StartDate,
			            _MaxDate
			        ),
			        TREATAS(
			            _TaiKhoansTheoChiTiet,
			            fact_finance[Tài khoản]
			        )
			    ) / 10^9
			
			VAR _GiaTri =
			    SWITCH(
			        TRUE(),
			
			        -- Ẩn dòng Chi tiết trống
			        _IsBlankDetail && NOT _IsSubAccount,
			            BLANK(),
			
			        _IsSubAccount,
			            _GiaTriChiTiet,
			
			        -- Dòng Chi tiết
			        _STTChiTiet > 0,
			            _GiaTriChiTiet,
			
			        -- Doanh thu thuần
			        _STT = 1,
			            [Doanh thu thuần_TY],
			
			        -- Giá vốn hàng bán
			        _STT = 2,
			            [Giá vốn hàng bán_TY],
			
			        -- Lợi nhuận gộp
			        _STT = 3,
			            [Lợi nhuận gộp_TY],
			
			        -- Chi phí hoạt động
			        _STT = 4,
			            [Chi phí hoạt động_TY],
			
			        -- Lợi nhuận hoạt động
			        _STT = 5,
			            [Lợi nhuận hoạt động (EBIT)_TY],
			
			        -- Chi phí tài chính và chi phí khác
			        _STT = 6,
			            [Chi phí Tài chính & Chi phí khác_TY],
			
			        -- Doanh thu tài chính và thu nhập khác
			        _STT = 7,
			            [Doanh thu Tài chính & Thu nhập khác_TY],
			
			        -- Lợi nhuận trước thuế
			        _STT = 8,
			            [Lợi nhuận trước thuế (EBT)_TY],
			
			        BLANK()
			    )
			
			RETURN
			    IF(
			        NOT _IsValidAccountForDetail,
			        BLANK(),
			        IF(
			            NOT ISBLANK(_GiaTri)
			            && ABS(_GiaTri) < 0.01,
			            BLANK(),
			            _GiaTri
			        )
			    )
		lineageTag: 2de2b277-6717-4f4f-99b1-5bd2a929ee0b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Giá trị P&L_LY' =
			
			VAR _STT =
			    SELECTEDVALUE(DimPL[STT])
			
			VAR _STTChiTiet =
			    SELECTEDVALUE(DimPL[STT Chi tiết])
			
			VAR _TaiKhoan =
			    SELECTEDVALUE(DimPL[Tài khoản])
			
			VAR _IsBlankDetail =
			    ISINSCOPE(DimPL[Chi tiết])
			        && ISBLANK(
			            SELECTEDVALUE(DimPL[Chi tiết])
			        )
			
			VAR _MaxDate =
			    [MaxDate]
			
			VAR _EndDate =
			    EDATE(
			        _MaxDate,
			        -12
			    )
			
			VAR _StartDate =
			    DATE(
			        YEAR(_EndDate),
			        1,
			        1
			    )
			
			VAR _GiaTriChiTiet =
			    -CALCULATE(
			        SUM(fact_finance[Trị giá]),
			        DATESBETWEEN(
			            Calendar[Date],
			            _StartDate,
			            _EndDate
			        ),
			        TREATAS(
			            {_TaiKhoan},
			            DimAccount[Tài khoản]
			        )
			    ) / 10^9
			
			VAR _GiaTri =
			    SWITCH(
			        TRUE(),
			
			        -- Ẩn dòng Chi tiết trống
			        _IsBlankDetail,
			            BLANK(),
			
			        -- Dòng Chi tiết
			        _STTChiTiet > 0,
			            _GiaTriChiTiet,
			
			        -- Doanh thu thuần
			        _STT = 1,
			            [Doanh thu thuần_LY],
			
			        -- Giá vốn hàng bán
			        _STT = 2,
			            [Giá vốn hàng bán_LY],
			
			        -- Lợi nhuận gộp
			        _STT = 3,
			            [Lợi nhuận gộp_LY],
			
			        -- Chi phí hoạt động
			        _STT = 4,
			            [Chi phí hoạt động_LY],
			
			        -- Lợi nhuận hoạt động
			        _STT = 5,
			            [Lợi nhuận hoạt động (EBIT)_LY],
			
			        -- Chi phí tài chính và chi phí khác
			        _STT = 6,
			            [Chi phí Tài chính & Chi phí khác_LY],
			
			        -- Doanh thu tài chính và thu nhập khác
			        _STT = 7,
			            [Doanh thu Tài chính & Thu nhập khác_LY],
			
			        -- Lợi nhuận trước thuế
			        _STT = 8,
			            [Lợi nhuận trước thuế (EBT)_LY],
			
			        BLANK()
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(_GiaTri)
			            && ABS(_GiaTri) < 0.01,
			        BLANK(),
			        _GiaTri
			    )
		lineageTag: b57cd87a-bae2-4694-ad4a-9c3387df5732

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Tăng trưởng so CK' =
			
			DIVIDE(
			    [Giá trị P&L_TY] - [Giá trị P&L_LY],
			    [Giá trị P&L_LY],
			    BLANK()
			)
		lineageTag: 286db956-b31c-4424-8dc4-45b96926dc77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hiển thị P&L' =
			
			VAR _GiaTri =
			    [Giá trị P&L_TY]
			
			VAR _IsDetail =
			    ISINSCOPE(DimPL[Chi tiết])
			
			VAR _IsBlankDetail =
			    _IsDetail
			        && ISBLANK(
			            SELECTEDVALUE(DimPL[Chi tiết])
			        )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    -- Không hiển thị dòng Chi tiết trống
			    _IsBlankDetail,
			        0,
			
			    -- Dòng Chỉ tiêu: luôn hiển thị
			    NOT _IsDetail,
			        1,
			
			    -- Dòng Chi tiết: chỉ hiển thị khi khác 0
			    NOT ISBLANK(_GiaTri)
			        && _GiaTri <> 0,
			        1,
			
			    0
			)
		formatString: 0
		lineageTag: d0102364-7cb7-4215-a264-02286d27fecd

	measure '+/- Giá trị so CK' = [Giá trị P&L_TY] - [Giá trị P&L_LY]
		lineageTag: 89b1ce2a-fdb8-4c1e-8b45-4438a1bcc941

		annotation PBI_FormatHint = {"isGeneralNumber":true}

