	measure MaxDate =
			
			CALCULATE(
			    MAX(fact_finance[Date]),
			    REMOVEFILTERS(fact_finance),
			    REMOVEFILTERS(Calendar)
			)
		formatString: General Date
		lineageTag: 0fb7ed5d-43a7-46ed-9e4a-1841ccd6195c

	measure 'Trị giá YTD_TY' =
			
			VAR MaxDate = [MaxDate]
			
			RETURN
			CALCULATE (
			    SUM(fact_finance[Trị giá]),
			    DATESBETWEEN (
			        Calendar[Date],
			        DATE (YEAR(MaxDate), 1, 1 ),
			        MaxDate
			    )
			)
		lineageTag: 7e66af86-380d-409f-a21d-e5246f1e93d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trị giá YTD_LY' =
			
			VAR MaxDate = [MaxDate]
			VAR EndDate = EDATE(MaxDate, -12)
			VAR StartDate = DATE(YEAR(EndDate), 1, 1)
			
			RETURN
			CALCULATE(
			    SUM(fact_finance[Trị giá]),
			    DATESBETWEEN(
			        Calendar[Date],
			        StartDate,
			        EndDate
			    )
			)
		lineageTag: 72ee5cc2-ab3e-41af-a2ad-0b74a27d08c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Doanh thu thuần_Montly' =
			
			-CALCULATE(
			    SUM(fact_finance[Trị giá]),
			    KEEPFILTERS(
