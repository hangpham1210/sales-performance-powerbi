	measure 'Tiêu đề Chi tiểt_TC' =
			
			VAR _MaxDate = [MaxDate]
			RETURN
			    "TỔNG QUAN TÌNH HÌNH TÀI CHÍNH THEO MÔ HÌNH/ KHU VỰC ĐẾN THÁNG "
			        & FORMAT(_MaxDate, "MM/YYYY")
		lineageTag: ccb08d88-7e28-455e-88da-a81eeaaf143b

	measure '% Tăng trưởng Doanh thu thuần_card' =
			
			VAR DT_Change =
			    [% Tăng trưởng Doanh thu thuần YTD]*100
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(DT_Change), BLANK(),
			        DT_Change > 0,
			            "▲" & FORMAT(DT_Change, "0.0") & "%",
			        DT_Change < 0,
			            "▼" & FORMAT(ABS(DT_Change), "0.0") & "%",
			        "–"
			    )
		lineageTag: 09f30974-5cb5-4c8b-9f1f-5c0531b4b290

	measure '% Tăng trưởng Lợi nhuận gộp_card' =
			
			VAR DT_Change =
			    [% Tăng trưởng Lợi nhuận gộp YTD]*100
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(DT_Change), BLANK(),
			        DT_Change > 0,
			            "▲" & FORMAT(DT_Change, "0.0") & "%",
			        DT_Change < 0,
			            "▼" & FORMAT(ABS(DT_Change), "0.0") & "%",
			        "–"
			    )
		lineageTag: bb87ceb2-d62f-4d6a-851d-d7bd81d87c95

	measure '% Tăng trưởng Lợi nhuận gộp YTD' =
			
			DIVIDE(
			    [Lợi nhuận gộp_TY] - [Lợi nhuận gộp_LY],
			    ABS([Lợi nhuận gộp_LY]),
			    BLANK()
			)
		lineageTag: c589c9d2-92a7-48b4-8cf9-186f10294734

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tăng trưởng Lợi nhuận trước thuế_card' = ```
			
			VAR DT_Change = [Lợi nhuận trước thuế (EBT)_TY] - [Lợi nhuận trước thuế (EBT)_LY]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(DT_Change), BLANK(),
			        DT_Change > 0,
			            "▲" & FORMAT(DT_Change, "0.0") & "tỷ.đ",
			        DT_Change < 0, 
			            "▼" & FORMAT(ABS(DT_Change), "0.0") & " tỷ.đ",
			        "–"
			    )
			```
		lineageTag: eba06755-8ecf-4410-9ecf-b70e95d385dc

	measure '% Tăng trưởng Giá vốn hàng bán_card' =
			
			VAR DT_Change = DIVIDE(
			    [Giá vốn hàng bán_TY]
			        - [Giá vốn hàng bán_LY],
			    [Giá vốn hàng bán_LY]
			)*100
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(DT_Change), BLANK(),
			        DT_Change > 0,
			            "▲" & FORMAT(DT_Change, "0.0") & "%",
			        DT_Change < 0,
			            "▼" & FORMAT(ABS(DT_Change), "0.0") & "%",
			        "–"
			    )
		lineageTag: 37706584-2aaf-47e7-98df-241c62822798

