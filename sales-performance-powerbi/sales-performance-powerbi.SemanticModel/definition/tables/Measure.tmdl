	measure 'Tiêu đề Tổng quan_TC' =
			
			VAR _MaxDate = [MaxDate]
			RETURN
			    "TỔNG QUAN TÌNH HÌNH TÀI CHÍNH ĐẾN THÁNG "
			        & FORMAT(_MaxDate, "MM/YYYY")
		lineageTag: 206a28be-d78d-4f9c-a64b-6a8a833514b1

	measure 'Tiêu đề Tổng quan_KD' =
			
			VAR _MonthKey = MAX('fact_sales_month'[MonthKey])
			VAR _Year = 2000 + INT(_MonthKey / 100)
			VAR _Month = MOD(_MonthKey, 100)
			VAR _Date = DATE(_Year, _Month, 1)
			
			RETURN
			    "TỔNG QUAN TÌNH HÌNH KINH DOANH ĐẾN THÁNG "
			        & FORMAT(_Date, "MM/YYYY")
		lineageTag: 887038eb-0ee3-42b8-b3bc-2efb4c635ae4

	measure 'Tiêu đề chi tiết_KD' =
			
			VAR _MonthKey = MAX('fact_sales_month'[MonthKey])
			VAR _Year = 2000 + INT(_MonthKey / 100)
			VAR _Month = MOD(_MonthKey, 100)
			VAR _Date = DATE(_Year, _Month, 1)
			
			RETURN
			    "TỔNG QUAN TÌNH HÌNH KINH DOANH THEO MÔ HÌNH/ KHU VỰC ĐẾN THÁNG "
			        & FORMAT(_Date, "MM/YYYY")
		lineageTag: fbf08132-4010-45d9-a430-5f8f8b6d5e3c

	measure 'Trị giá YTD_TY minus Trị giá YTD_LY' =
			
			[Trị giá YTD_TY] - [Trị giá YTD_LY]
		lineageTag: e33c88c5-5758-4bb1-9127-7971b2443b36

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalSubtraction"
				}

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trị giá YTD_TY % difference from Trị giá YTD_LY' =
			
			VAR __BASELINE_VALUE = [Trị giá YTD_LY]
			VAR __VALUE_TO_COMPARE = [Trị giá YTD_TY]
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE - __BASELINE_VALUE, __BASELINE_VALUE)
				)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a9860c04-9713-4a4c-b861-cd85d64ac7a4

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalPercentageDifference"
				}

