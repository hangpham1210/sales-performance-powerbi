			        KEEPFILTERS(fact_finance[Diễn giải tài khoản] IN {"Doanh thu bán hàng & cung cấp dịch vụ", "Doanh thu bán hàng nội bộ", "Các khoản giảm trừ doanh thu"})
			    )
