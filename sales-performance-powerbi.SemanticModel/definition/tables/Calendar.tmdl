table Calendar
	lineageTag: 42382134-9cac-446e-b4b7-335ff12caf74
	dataCategory: Time

	measure 'Has Data TY' =
			
			VAR MaxDate = [MaxDate]
			VAR CurrentYear =
			    MAX(Calendar[Year])
			VAR CurrentMonth =
			    MAX(Calendar[Month No])
			VAR MaxYear =
			    YEAR(MaxDate)
			VAR MaxMonth =
			    MONTH(MaxDate)
			
			RETURN
			IF(
			    CurrentYear < MaxYear
			        || (
			            CurrentYear = MaxYear
			            && CurrentMonth <= MaxMonth
			        ),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 6a508824-0dab-4774-8ba1-9f30b63e1a50

	column Date
		isKey
		formatString: General Date
		lineageTag: f859afca-fb05-4016-99bc-294981fa942c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 437fd517-ab6b-41fc-8698-98bf670163d8
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month No'
		formatString: 0
		lineageTag: fded0cc9-056a-4b57-8d9a-9ecb96c39ea3
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Month No]

		annotation SummarizationSetBy = Automatic

	column Month
		lineageTag: a882bdef-0048-4c0d-9127-3e5a9f05233f
